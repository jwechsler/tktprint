#!/bin/bash
# Docker startup script for TKTPrint with printer configuration support

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Default environment - use RAILS_ENV if set, otherwise development
PRINTER_ENV="${RAILS_ENV:-development}"

# Parse command line arguments for --environment flag
ARGS=()
while [[ $# -gt 0 ]]; do
    case $1 in
        --environment)
            PRINTER_ENV="$2"
            shift # past argument
            shift # past value
            ;;
        *)
            ARGS+=("$1") # save other arguments
            shift # past argument
            ;;
    esac
done

# Set positional arguments
set -- "${ARGS[@]}"

function setup_printer_config() {
    local env="$1"
    local config_file="config/printer.yml.$env"
    
    if [ -f "$config_file" ]; then
        echo -e "${YELLOW}Setting up printer configuration for $env environment...${NC}"
        cp "$config_file" config/printer.yml
        echo -e "${GREEN}✓ Copied $config_file to config/printer.yml${NC}"
    else
        echo -e "${RED}Warning: $config_file not found, using existing config/printer.yml${NC}"
    fi
}

function print_usage() {
    echo "Usage: $0 [--environment {development|production}] {build|up|down|restart|logs|shell|console|test|init}"
    echo ""
    echo "Options:"
    echo "  --environment  - Specify printer environment (development or production)"
    echo ""
    echo "Commands:"
    echo "  build    - Build Docker images"
    echo "  up       - Start all services"
    echo "  down     - Stop all services"
    echo "  restart  - Restart all services"
    echo "  logs     - Show logs (optionally specify service: web, worker, printer_emulator)"
    echo "  shell    - Open a shell in the web container"
    echo "  console  - Open Rails console"
    echo "  test     - Run tests"
    echo "  init     - Initialize configuration files"
    echo "  status   - Show container status"
    echo "  clean    - Clean up containers and volumes"
}

case "$1" in
    build)
        echo -e "${YELLOW}Building Docker images...${NC}"
        docker-compose build
        echo -e "${GREEN}✓ Build complete${NC}"
        ;;
    
    up)
        echo -e "${YELLOW}Initializing configuration...${NC}"
        ./docker/init.sh
        setup_printer_config "$PRINTER_ENV"
        echo -e "${YELLOW}Starting services...${NC}"
        docker-compose up -d
        echo -e "${GREEN}✓ Services started${NC}"
        echo ""
        echo "Services available at:"
        echo "  - Rails app: http://localhost:3000"
        echo "  - Printer emulator: localhost:9100"
        echo ""
        echo "View logs with: $0 logs"
        ;;
    
    down)
        echo -e "${YELLOW}Stopping services...${NC}"
        docker-compose down
        echo -e "${GREEN}✓ Services stopped${NC}"
        ;;
    
    restart)
        $0 down
        $0 --environment "$PRINTER_ENV" up
        ;;
    
    logs)
        if [ -z "$2" ]; then
            docker-compose logs -f --tail=100
        else
            docker-compose logs -f --tail=100 "$2"
        fi
        ;;
    
    shell)
        echo -e "${YELLOW}Opening shell in web container...${NC}"
        docker-compose exec web bash
        ;;
    
    console)
        echo -e "${YELLOW}Opening Rails console...${NC}"
        docker-compose exec web bundle exec rails console
        ;;
    
    test)
        echo -e "${YELLOW}Running tests...${NC}"
        docker-compose exec web bundle exec rails test
        ;;
    
    init)
        echo -e "${YELLOW}Initializing configuration files...${NC}"
        ./docker/init.sh
        echo -e "${GREEN}✓ Configuration initialized${NC}"
        ;;
    
    status)
        echo -e "${YELLOW}Container status:${NC}"
        docker-compose ps
        ;;
    
    clean)
        echo -e "${RED}This will remove all containers and volumes. Are you sure? (y/N)${NC}"
        read -r response
        if [[ "$response" =~ ^([yY][eE][sS]|[yY])$ ]]; then
            docker-compose down -v
            echo -e "${GREEN}✓ Cleanup complete${NC}"
        else
            echo "Cleanup cancelled"
        fi
        ;;
    
    *)
        print_usage
        exit 1
        ;;
esac