# Copy to .env (gitignored). start-printer.sh writes RAILS_ENV, SECRET_KEY_BASE,
# HOST_UID and HOST_GID itself and keeps the values below across runs.

# Hostnames and IPs the web server answers to, comma-separated. Unset = accept any host.
TKTPRINT_HOSTS=tickets.example.org,192.168.1.20

# Virtual Boca printer (optional)
#BOCA_FONT_DIR=./tmp/fonts
#FGL_PDF_REF=main
